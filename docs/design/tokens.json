{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "HWPanel MVP DTCG Design Tokens (Light & Dark, iOS & Android)",
  "color": {
    "primitive": {
      "blue": {
        "50": { "$value": "#EDF3FF", "$type": "color" },
        "100": { "$value": "#DDE8FF", "$type": "color" },
        "400": { "$value": "#5E90FF", "$type": "color" },
        "500": { "$value": "#2F6BFF", "$type": "color" },
        "600": { "$value": "#2057DD", "$type": "color" },
        "700": { "$value": "#173B99", "$type": "color" },
        "900": { "$value": "#112247", "$type": "color" }
      },
      "neutral": {
        "0": { "$value": "#FFFFFF", "$type": "color" },
        "50": { "$value": "#F8F9FB", "$type": "color" },
        "100": { "$value": "#F5F6F9", "$type": "color" },
        "150": { "$value": "#F2F3F6", "$type": "color" },
        "200": { "$value": "#E9ECF2", "$type": "color" },
        "300": { "$value": "#D9DDE5", "$type": "color" },
        "450": { "$value": "#666D7B", "$type": "color" },
        "500": { "$value": "#596070", "$type": "color" },
        "700": { "$value": "#343B4B", "$type": "color" },
        "850": { "$value": "#1C212E", "$type": "color" },
        "900": { "$value": "#171B26", "$type": "color" },
        "925": { "$value": "#131722", "$type": "color" },
        "950": { "$value": "#0D1017", "$type": "color" }
      },
      "green": {
        "50": { "$value": "#EAF9F0", "$type": "color" },
        "400": { "$value": "#4ADE80", "$type": "color" },
        "500": { "$value": "#22C55E", "$type": "color" },
        "700": { "$value": "#137A3C", "$type": "color" }
      },
      "amber": {
        "50": { "$value": "#FFF5E3", "$type": "color" },
        "400": { "$value": "#FBBF24", "$type": "color" },
        "500": { "$value": "#F59E0B", "$type": "color" },
        "700": { "$value": "#996008", "$type": "color" }
      },
      "red": {
        "50": { "$value": "#FFEDED", "$type": "color" },
        "100": { "$value": "#FEE2E2", "$type": "color" },
        "400": { "$value": "#F87171", "$type": "color" },
        "500": { "$value": "#EF4444", "$type": "color" },
        "700": { "$value": "#C63434", "$type": "color" }
      },
      "cyan": {
        "500": { "$value": "#27A4C4", "$type": "color" }
      }
    },
    "semantic": {
      "light": {
        "bg.canvas": { "$value": "#F2F3F6", "$type": "color", "$description": "全局页面底色" },
        "bg.heroGradientStart": { "$value": "#DDE4F5", "$type": "color" },
        "bg.heroGradientMid": { "$value": "#EDF0F7", "$type": "color" },
        "bg.heroGradientEnd": { "$value": "#F2F3F6", "$type": "color" },
        "bg.heroGradient": {
          "$type": "gradient",
          "$value": [
            { "color": "#DDE4F5", "position": 0 },
            { "color": "#EDF0F7", "position": 0.22 },
            { "color": "#F2F3F6", "position": 0.48 }
          ],
          "$description": "fnOS 风格页面顶部浅蓝氛围渐变"
        },
        "bg.surface": { "$value": "#FFFFFF", "$type": "color", "$description": "主卡片与弹窗表面" },
        "bg.surfaceSoft": { "$value": "#F5F6F9", "$type": "color", "$description": "次级卡片内嵌块、输入底色、筛选胶囊底" },
        "bg.surfaceMuted": { "$value": "#F8F9FB", "$type": "color", "$description": "离线卡片与禁用区块底色" },
        "bg.segmentedTrack": { "$value": "#E9EDF4", "$type": "color", "$description": "分段控制器轨道底色" },
        "bg.tabBarGlass": { "$value": "rgba(255, 255, 255, 0.88)", "$type": "color", "$description": "底部 5 Tab 栏毛玻璃底色" },
        "bg.pillGlass": { "$value": "rgba(255, 255, 255, 0.82)", "$type": "color", "$description": "顶部服务器切换胶囊与悬浮按钮底色" },
        "bg.codeBlock": { "$value": "#0F1420", "$type": "color", "$description": "日志流与 YAML 编辑器深色代码区底色" },
        "bg.overlay": { "$value": "rgba(15, 23, 42, 0.44)", "$type": "color", "$description": "模态弹窗与底部抽屉遮罩" },
        "text.primary": { "$value": "#171B26", "$type": "color", "$description": "主标题、核心数值" },
        "text.secondary": { "$value": "#343B4B", "$type": "color", "$description": "正文、列表主项" },
        "text.muted": { "$value": "#596070", "$type": "color", "$description": "辅助信息、单位、次级标签（AA >= 6.1:1）" },
        "text.subtle": { "$value": "#666D7B", "$type": "color", "$description": "占位符、时间戳、禁用文案（AA >= 4.7:1 on canvas/surface）" },
        "text.onBrand": { "$value": "#FFFFFF", "$type": "color", "$description": "品牌色/危险红主按钮文字" },
        "text.code": { "$value": "#E5ECFF", "$type": "color", "$description": "代码/日志区域默认前景" },
        "border.hairline": { "$value": "#E9ECF2", "$type": "color", "$description": "卡片内部分割线与输入框边界" },
        "border.control": { "$value": "#D9DDE5", "$type": "color", "$description": "开关关闭态、复选框描边" },
        "brand.primary": { "$value": "#2F6BFF", "$type": "color", "$description": "HWPanel 科技蓝主色" },
        "brand.pressed": { "$value": "#2057DD", "$type": "color" },
        "brand.soft": { "$value": "#EDF3FF", "$type": "color" },
        "brand.onSoft": { "$value": "#2057DD", "$type": "color" },
        "status.success": { "$value": "#22C55E", "$type": "color" },
        "status.successBg": { "$value": "#EAF9F0", "$type": "color" },
        "status.successText": { "$value": "#137A3C", "$type": "color" },
        "status.warning": { "$value": "#F59E0B", "$type": "color" },
        "status.warningBg": { "$value": "#FFF5E3", "$type": "color" },
        "status.warningText": { "$value": "#996008", "$type": "color" },
        "status.danger": { "$value": "#EF4444", "$type": "color" },
        "status.dangerBg": { "$value": "#FFEDED", "$type": "color" },
        "status.dangerBorder": { "$value": "#FEE2E2", "$type": "color" },
        "status.dangerText": { "$value": "#C63434", "$type": "color" },
        "chart.track": { "$value": "#EDF0F4", "$type": "color", "$description": "环形图/进度条背景轨道" },
        "chart.grid": { "$value": "#E5E9F0", "$type": "color", "$description": "折线图横向辅助网格线" },
        "chart.axis": { "$value": "#666D7B", "$type": "color", "$description": "折线图坐标轴刻度文字" },
        "chart.cpu": { "$value": "#2F6BFF", "$type": "color" },
        "chart.memory": { "$value": "#27A4C4", "$type": "color" },
        "chart.disk": { "$value": "#6366F1", "$type": "color" },
        "chart.netUp": { "$value": "#2F6BFF", "$type": "color" },
        "chart.netDown": { "$value": "#22C55E", "$type": "color" },
        "skeleton.base": { "$value": "#E8ECF3", "$type": "color", "$description": "骨架屏底色" },
        "skeleton.shimmer": { "$value": "#F5F7FB", "$type": "color", "$description": "骨架屏高光扫光色" },
        "state.pressOverlay": { "$value": "rgba(23, 27, 38, 0.05)", "$type": "color", "$description": "列表行与卡片按压态叠加色" }
      },
      "dark": {
        "bg.canvas": { "$value": "#0D1017", "$type": "color", "$description": "深色全局页面底色" },
        "bg.heroGradientStart": { "$value": "#15213B", "$type": "color" },
        "bg.heroGradientMid": { "$value": "#101625", "$type": "color" },
        "bg.heroGradientEnd": { "$value": "#0D1017", "$type": "color" },
        "bg.heroGradient": {
          "$type": "gradient",
          "$value": [
            { "color": "#15213B", "position": 0 },
            { "color": "#101625", "position": 0.22 },
            { "color": "#0D1017", "position": 0.48 }
          ],
          "$description": "深色模式顶部冷蓝氛围渐变"
        },
        "bg.surface": { "$value": "#171C28", "$type": "color", "$description": "深色主卡片与弹窗表面" },
        "bg.surfaceSoft": { "$value": "#1F2636", "$type": "color", "$description": "深色内嵌块、输入底色、筛选胶囊底" },
        "bg.surfaceMuted": { "$value": "#131722", "$type": "color", "$description": "深色离线卡片与禁用区块" },
        "bg.segmentedTrack": { "$value": "#1C2333", "$type": "color" },
        "bg.tabBarGlass": { "$value": "rgba(23, 28, 40, 0.88)", "$type": "color" },
        "bg.pillGlass": { "$value": "rgba(31, 38, 54, 0.82)", "$type": "color" },
        "bg.codeBlock": { "$value": "#090C12", "$type": "color" },
        "bg.overlay": { "$value": "rgba(0, 0, 0, 0.64)", "$type": "color" },
        "text.primary": { "$value": "#F3F6FC", "$type": "color" },
        "text.secondary": { "$value": "#CDD5E3", "$type": "color" },
        "text.muted": { "$value": "#9AA4B8", "$type": "color", "$description": "深色次级文字（AA >= 6.5:1）" },
        "text.subtle": { "$value": "#8892A6", "$type": "color", "$description": "深色占位符与时间戳（AA >= 5.2:1 on surface）" },
        "text.onBrand": { "$value": "#FFFFFF", "$type": "color" },
        "text.code": { "$value": "#E5ECFF", "$type": "color" },
        "border.hairline": { "$value": "#262E40", "$type": "color" },
        "border.control": { "$value": "#39445C", "$type": "color" },
        "brand.primary": { "$value": "#4D82FF", "$type": "color", "$description": "深色模式提亮科技蓝以保证 AA 对比度" },
        "brand.pressed": { "$value": "#356BF0", "$type": "color" },
        "brand.soft": { "$value": "rgba(77, 130, 255, 0.16)", "$type": "color" },
        "brand.onSoft": { "$value": "#8FB2FF", "$type": "color" },
        "status.success": { "$value": "#34D399", "$type": "color" },
        "status.successBg": { "$value": "rgba(34, 197, 94, 0.16)", "$type": "color" },
        "status.successText": { "$value": "#6EE7B7", "$type": "color" },
        "status.warning": { "$value": "#FBBF24", "$type": "color" },
        "status.warningBg": { "$value": "rgba(245, 158, 11, 0.16)", "$type": "color" },
        "status.warningText": { "$value": "#FCD34D", "$type": "color" },
        "status.danger": { "$value": "#F87171", "$type": "color" },
        "status.dangerBg": { "$value": "rgba(239, 68, 68, 0.16)", "$type": "color" },
        "status.dangerBorder": { "$value": "rgba(248, 113, 113, 0.30)", "$type": "color" },
        "status.dangerText": { "$value": "#FCA5A5", "$type": "color" },
        "chart.track": { "$value": "#262F42", "$type": "color" },
        "chart.grid": { "$value": "#232B3D", "$type": "color" },
        "chart.axis": { "$value": "#8892A6", "$type": "color" },
        "chart.cpu": { "$value": "#4D82FF", "$type": "color" },
        "chart.memory": { "$value": "#38BDF8", "$type": "color" },
        "chart.disk": { "$value": "#818CF8", "$type": "color" },
        "chart.netUp": { "$value": "#4D82FF", "$type": "color" },
        "chart.netDown": { "$value": "#34D399", "$type": "color" },
        "skeleton.base": { "$value": "#1E2534", "$type": "color" },
        "skeleton.shimmer": { "$value": "#293246", "$type": "color" },
        "state.pressOverlay": { "$value": "rgba(243, 246, 252, 0.06)", "$type": "color" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$value": ["-apple-system", "SF Pro Text", "PingFang SC", "Roboto", "Noto Sans SC", "sans-serif"],
        "$type": "fontFamily"
      },
      "mono": {
        "$value": ["SFMono-Regular", "JetBrains Mono", "Roboto Mono", "Consolas", "monospace"],
        "$type": "fontFamily"
      }
    },
    "scale": {
      "pageTitle": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "28px", "lineHeight": "35px", "fontWeight": 700, "letterSpacing": "-0.6px" }
      },
      "navTitle": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "17px", "lineHeight": "22px", "fontWeight": 600, "letterSpacing": "-0.2px" }
      },
      "sectionTitle": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "18px", "lineHeight": "24px", "fontWeight": 600, "letterSpacing": "-0.3px" }
      },
      "cardTitle": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "16px", "lineHeight": "22px", "fontWeight": 600, "letterSpacing": "-0.15px" }
      },
      "body": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "15px", "lineHeight": "22px", "fontWeight": 400, "letterSpacing": "0px" }
      },
      "bodyMedium": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "14px", "lineHeight": "20px", "fontWeight": 500, "letterSpacing": "0px" }
      },
      "caption": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "12px", "lineHeight": "17px", "fontWeight": 400, "letterSpacing": "0px" }
      },
      "badge": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "11px", "lineHeight": "14px", "fontWeight": 600, "letterSpacing": "0px" }
      },
      "tabLabel": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "10px", "lineHeight": "12px", "fontWeight": 500, "letterSpacing": "0px" }
      },
      "metricLarge": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.sans}", "fontSize": "20px", "lineHeight": "24px", "fontWeight": 700, "letterSpacing": "-0.4px" },
        "$extensions": { "hwpanel": { "fontVariantNumeric": "tabular-nums" } }
      },
      "code": {
        "$type": "typography",
        "$value": { "fontFamily": "{typography.fontFamily.mono}", "fontSize": "12px", "lineHeight": "19px", "fontWeight": 400, "letterSpacing": "0px" }
      }
    }
  },
  "spacing": {
    "1": { "$value": "4px", "$type": "dimension" },
    "2": { "$value": "8px", "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension", "$description": "卡片列表间距（cardGap）" },
    "4": { "$value": "16px", "$type": "dimension", "$description": "页面边距与卡片内边距（pageHorizontal / cardPadding）" },
    "5": { "$value": "20px", "$type": "dimension", "$description": "分区间距（sectionGap）" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "pageHorizontal": { "$value": "16px", "$type": "dimension" },
    "cardPadding": { "$value": "16px", "$type": "dimension" },
    "cardGap": { "$value": "12px", "$type": "dimension" },
    "sectionGap": { "$value": "20px", "$type": "dimension" }
  },
  "radius": {
    "xs": { "$value": "7px", "$type": "dimension", "$description": "状态徽标 Chip" },
    "sm": { "$value": "12px", "$type": "dimension", "$description": "次级区块、小卡片、输入框" },
    "md": { "$value": "16px", "$type": "dimension", "$description": "按钮、分段器、应用图标" },
    "lg": { "$value": "22px", "$type": "dimension", "$description": "fnOS 风格主内容卡片" },
    "xl": { "$value": "26px", "$type": "dimension", "$description": "底部抽屉、居中确认弹窗" },
    "pill": { "$value": "999px", "$type": "dimension", "$description": "搜索框、服务器切换胶囊、开关" }
  },
  "borderWidth": {
    "hairline": { "$value": "1px", "$type": "dimension" },
    "focus": { "$value": "2px", "$type": "dimension" },
    "iconStroke": { "$value": "1.7px", "$type": "dimension" }
  },
  "iconSize": {
    "sm": { "$value": "16px", "$type": "dimension" },
    "md": { "$value": "20px", "$type": "dimension" },
    "lg": { "$value": "24px", "$type": "dimension" },
    "empty": { "$value": "32px", "$type": "dimension" }
  },
  "blur": {
    "tabBar": { "$value": "18px", "$type": "dimension", "$description": "底部 5 Tab 毛玻璃高斯模糊半径" },
    "pill": { "$value": "12px", "$type": "dimension", "$description": "顶部服务器切换胶囊毛玻璃模糊半径" }
  },
  "opacity": {
    "disabled": { "$value": 0.45, "$type": "number", "$description": "禁用控件与按钮透明度" },
    "offlineCard": { "$value": 0.86, "$type": "number" }
  },
  "elevation": {
    "light": {
      "card": {
        "$type": "shadow",
        "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "rgba(20, 30, 60, 0.06)" },
        "$extensions": { "hwpanel": { "androidElevation": 2 } }
      },
      "floating": {
        "$type": "shadow",
        "$value": { "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px", "color": "rgba(20, 30, 60, 0.12)" },
        "$extensions": { "hwpanel": { "androidElevation": 6 } }
      },
      "tabBar": {
        "$type": "shadow",
        "$value": { "offsetX": "0px", "offsetY": "-8px", "blur": "24px", "spread": "0px", "color": "rgba(20, 30, 60, 0.04)" },
        "$extensions": { "hwpanel": { "androidElevation": 8 } }
      }
    },
    "dark": {
      "card": {
        "$type": "shadow",
        "$value": { "offsetX": "0px", "offsetY": "6px", "blur": "20px", "spread": "0px", "color": "rgba(0, 0, 0, 0.32)" },
        "$extensions": { "hwpanel": { "androidElevation": 2, "topHighlightBorder": "rgba(255, 255, 255, 0.05)" } }
      },
      "floating": {
        "$type": "shadow",
        "$value": { "offsetX": "0px", "offsetY": "16px", "blur": "36px", "spread": "0px", "color": "rgba(0, 0, 0, 0.48)" },
        "$extensions": { "hwpanel": { "androidElevation": 8 } }
      },
      "tabBar": {
        "$type": "shadow",
        "$value": { "offsetX": "0px", "offsetY": "-8px", "blur": "24px", "spread": "0px", "color": "rgba(0, 0, 0, 0.36)" },
        "$extensions": { "hwpanel": { "androidElevation": 8 } }
      }
    }
  },
  "zIndex": {
    "base": { "$value": 0, "$type": "number" },
    "sticky": { "$value": 10, "$type": "number" },
    "tabBar": { "$value": 30, "$type": "number" },
    "sheet": { "$value": 60, "$type": "number" },
    "dialog": { "$value": 80, "$type": "number" },
    "toast": { "$value": 95, "$type": "number" }
  },
  "motion": {
    "duration": {
      "fast": { "$value": "160ms", "$type": "duration", "$description": "按钮按压、开关、分段切换" },
      "page": { "$value": "220ms", "$type": "duration", "$description": "页面转场与抽屉展开" },
      "gauge": { "$value": "420ms", "$type": "duration", "$description": "环形图/进度条平滑更新" }
    },
    "easing": {
      "standard": { "$value": [0.2, 0.7, 0.2, 1], "$type": "cubicBezier" }
    },
    "pressScale": { "$value": 0.97, "$type": "number" }
  },
  "$extensions": {
    "hwpanel": {
      "meta": {
        "product": "HWPanel",
        "version": "1.0.1",
        "referenceStyle": "fnOS Mobile (Modern Rounded Card + Tech Blue)",
        "platforms": ["ios", "android"],
        "themes": ["light", "dark"],
        "defaultTheme": "system",
        "locale": "zh-CN",
        "baseViewport": { "width": 390, "height": 844, "unit": "pt/dp" }
      },
      "layout": {
        "touchTargetMin": 44,
        "topBarHeight": 56,
        "tabBarHeight": 56,
        "tabBarCount": 5,
        "ringGaugeSize": 88,
        "ringStrokeWidth": 6,
        "safeArea": {
          "ios": { "top": 50, "bottom": 34 },
          "android": { "top": 36, "bottom": 20 }
        }
      },
      "components": {
        "tabBar": {
          "columns": 5,
          "activeIndicator": "bottom-dot-5px",
          "items": [
            { "id": "overview", "label": "概览", "icon": "gauge" },
            { "id": "containers", "label": "容器", "icon": "box" },
            { "id": "apps", "label": "应用", "icon": "grid" },
            { "id": "tasks", "label": "任务", "icon": "clock" },
            { "id": "more", "label": "更多", "icon": "sliders" }
          ]
        },
        "loadThresholds": {
          "normalMax": 69,
          "warningMax": 89,
          "dangerMin": 90
        }
      }
    }
  }
}
